{
  "name": "i18n-react-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:translations",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pretypecheck": "npm run check:translations",
    "typecheck": "tsc --noEmit",
    "check:translations": "node scripts/check-translations.mjs",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "interface": "i18next-resources-for-ts interface -i ./locales/en -o ./types/resources.generated.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^24.0.5",
    "lucide-react": "^0.468.0",
    "next": "14.2.15",
    "react": "^18",
    "react-dom": "^18",
    "react-i18next": "^15.1.4",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.6.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "i18next-resources-for-ts": "^1.5.0"
  }
}
